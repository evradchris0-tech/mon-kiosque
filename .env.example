# Copier en .env (jamais commité). Toutes les variables sont lues par backend/app/core/config.py.

# Environnement : dev | staging | prod
MOKI_ENV=dev

# Base de données. En dev local sans Docker, SQLite suffit ; en staging/prod, PostgreSQL.
MOKI_DATABASE_URL=sqlite+pysqlite:///./moki_dev.db
# MOKI_DATABASE_URL=postgresql+psycopg://moki:moki@localhost:5432/moki

# Modèle de langage (SDK Anthropic : la clé est lue dans ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=
MOKI_MODELE=claude-opus-5-5
MOKI_EFFORT=low
# factice | claude  (factice = aucun appel réseau, pour le dev et les tests)
MOKI_INTERPRETE=factice

# WhatsApp Cloud API (Meta)
MOKI_WHATSAPP_JETON=
MOKI_WHATSAPP_ID_NUMERO=
MOKI_WHATSAPP_JETON_VERIFICATION=choisir-une-chaine-secrete
MOKI_WHATSAPP_SECRET_APP=
# factice | cloud_api
MOKI_CANAL=factice

# Console interne (deux comptes nominatifs en prod ; ici un seul pour le dev)
MOKI_CONSOLE_UTILISATEUR=admin
MOKI_CONSOLE_MOT_DE_PASSE=changer-ce-mot-de-passe

# Métier
MOKI_FUSEAU_DEFAUT=Africa/Douala
MOKI_HEURE_RESUME=19
MOKI_SEUIL_CONFIRMATION_RENFORCEE=50000
